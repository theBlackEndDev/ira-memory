MEMORY_DATABASE_URL="postgresql://ira_memory:ira_memory_secret@localhost:5433/ira_memory"

# ─── LLM provider (embeddings + summaries) ──────────────────────
# IRA_LLM_PROVIDER selects where embeddings and summaries are computed:
#   openai (default) — OpenAI cloud. Set OPENAI_API_KEY below.
#   gemini           — Google Gemini (OpenAI-compatible endpoint). Set GEMINI_API_KEY.
#                      Flash for summaries + Gemini embeddings; reuses your Gemini access.
#   local            — OpenAI-compatible local server (Ollama/LM Studio). Set OPENAI_BASE_URL.
#   none             — NO external calls at all. Embeddings + summaries skipped; recall uses
#                      full-text + project tags. Nothing leaves the machine.
# IRA_LLM_PROVIDER="openai"

OPENAI_API_KEY="your-openai-api-key-here"   # only for provider=openai
# GEMINI_API_KEY="your-gemini-api-key-here" # only for provider=gemini

# Turn embeddings OFF independent of the provider (recall falls back to full-text + tags).
# Handy with provider=gemini to get Flash summaries without the embedding-dimension question.
# IRA_EMBED="off"

# Model + endpoint overrides (sensible defaults per provider; rarely needed):
# OPENAI_BASE_URL="http://localhost:11434/v1"   # local server, or a custom Gemini-compat URL
# IRA_LLM_MODEL="gemini-2.5-flash"              # chat/summary model
# IRA_EMBED_MODEL="gemini-embedding-001"        # embedding model
# IRA_EMBED_DIMS="1536"                         # must match the pgvector schema; only change on a fresh DB

# ─── Optional overrides ─────────────────────────────────────────
# Absolute path to your `bun` binary. Set this if bun is not at the
# default ~/.bun/bin/bun location (e.g. bun installed via nvm, asdf,
# pnpm, nix, or a custom prefix). Used by `install-hooks` (so the
# SessionEnd hook command in ~/.claude/settings.json points at the
# right binary) and by scripts/cron-maintain.sh.
# IRA_BUN_PATH="/opt/bun/bin/bun"

# Override the backups/ directory used by `backup` and `restore`.
# Defaults to <project>/backups. Useful for pointing at external
# storage or a shared backup volume.
# IRA_BACKUP_DIR="/var/backups/ira-memory"

# Override the project root detection in scripts/cron-maintain.sh.
# You shouldn't normally need this — the script resolves its own
# location — but set it if you wrap the script in unusual ways.
# IRA_PROJECT_DIR="/opt/ira-memory"
# IRA_LOG_DIR="/var/log/ira-memory"
